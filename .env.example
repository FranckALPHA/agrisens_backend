# AgriSens backend — exemple de configuration (valeurs factices).
# Copier ce fichier en `.env` (jamais versionné) et renseigner les vraies
# valeurs. Voir AGENTS.md pour le démarrage sans Docker.

# local | test | staging | production
ENVIRONNEMENT=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=fake-django-secret-key-a-changer

# Base MySQL 8.4 installée nativement (pas de Docker, journal Q-31).
DATABASE_URL=mysql+pymysql://agrisens:changer@127.0.0.1:3306/agrisens?charset=utf8mb4
DATABASE_URL_TEST=mysql+pymysql://agrisens:changer@127.0.0.1:3306/agrisens_test?charset=utf8mb4
DATABASE_URL_E2E=mysql+pymysql://agrisens:changer@127.0.0.1:3306/agrisens_e2e?charset=utf8mb4

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_SECRET=fake-jwt-secret-a-changer-0123456789abcdef
JWT_DUREE_ACCES_MIN=15
JWT_DUREE_RAFRAICHISSEMENT_JOURS=30

# Chiffrement des codes de remise (Fernet, généré par F-08)
CODE_REMISE_CLE=fake-fernet-key-a-changer

# NotchPay — mode `factice` pour les tests et le local (journal Q-22)
NOTCHPAY_MODE=factice
NOTCHPAY_CLE_PUBLIQUE=fake-public-key
NOTCHPAY_CLE_PRIVEE=fake-private-key
NOTCHPAY_SECRET_WEBHOOK=fake-webhook-secret
NOTCHPAY_URL_BASE=https://api.notchpay.co

# IA — fournisseur `factice` par défaut en local et en test (journal Q-07 / 01 §1ter)
IA_FOURNISSEUR=factice
IA_URL_BASE=https://api.groq.com/openai/v1
IA_CLE_API=fake-groq-key
IA_MODELE=fake-modele

# Stockage des fichiers (hors racine web)
STOCKAGE_FICHIERS_CHEMIN=./stockage
URL_SIGNEE_SECRET=fake-signed-url-secret

# CORS et URLs publiques
CORS_ORIGINES=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL_PUBLIQUE=http://localhost:8000
